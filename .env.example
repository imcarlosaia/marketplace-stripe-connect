# Copy this file to .env.local and fill in the values.

# Supabase: project home page -> Copy, or Project Settings -> API.
# Both are public values. On Vercel add them as Config.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key, used only by the server to record sellers and orders.
# Project Settings -> API Keys -> Secret keys. On Vercel add it as Secret.
SUPABASE_SECRET_KEY=

# Stripe sandbox (test mode) keys. Never commit the secret key.
# On Vercel: the publishable key as Config, the other two as Secret.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Printed once by scripts/create-webhook.mjs after the first deploy.
STRIPE_WEBHOOK_SECRET=

# Brevo, for emailing sellers (optional; messages are saved without it).
# The API key is a secret. On Vercel add these as Secret.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Marketplace
